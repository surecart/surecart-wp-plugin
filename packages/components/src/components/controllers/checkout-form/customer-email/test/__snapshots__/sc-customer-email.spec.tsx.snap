          <sc-icon aria-label="Account options" name="chevron-down"></sc-icon>
        </sc-button>
        <sc-menu>
          <sc-menu-item>
            <sc-icon name="log-out" slot="prefix"></sc-icon>
            Logout
          </sc-menu-item>
        </sc-menu>
      </sc-dropdown>
    </div>
  </mock:shadow-root>
</sc-customer-email>
`;

