exports[`sc-customer-email Logged In Url Params Checkout email provided 1`] = `
<sc-customer-email size="medium">
  <mock:shadow-root>
    <div class="email-preview">
      <div class="email-preview__info">
        <sc-avatar image="" initials=""></sc-avatar>
        <div class="email-preview__text">
          <div class="email-preview__name"></div>
          <div class="email-preview__email"></div>
        </div>
      </div>
      <sc-dropdown placement="bottom-end">
