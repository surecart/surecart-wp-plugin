{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "surecart/bundle-item-variant",
	"title": "Bundle Item Variant",
	"description": "Per-component variant pill picker shown on the bundle product page. Renders one pill per option value; selections are sent as bundle_component_variants on add to cart.",
	"version": "1.0.0",
	"category": "surecart-product-page",
	"ancestor": ["surecart/bundle-item-template"],
	"usesContext": ["surecart/bundleItem", "surecart/bundleItemOption"],
	"supports": {
		"interactivity": true,
		"inserter": false,
		"anchor": true,
		"html": false,
		"spacing": {
			"padding": true,
			"margin": ["top", "bottom"]
		},
		"color": {
			"text": true,
			"background": false
		}
	},
	"textdomain": "surecart",
	"render": "file:./view.php",
	"editorScript": "file:./index.js",
	"style": ["surecart-pill", "surecart-product-variants"]
}
