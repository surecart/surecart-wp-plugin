{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "surecart/product-quantity-control",
	"title": "Control",
	"description": "Display the product quantity control",
	"version": "1.0.0",
	"category": "surecart-product-page",
	"icon": "media-interactive",
	"ancestor": ["surecart/product-quantity"],
	"keywords": ["quantity", "form", "product"],
	"supports": {
		"interactivity": true,
		"dimensions": {
			"minHeight": true
		},
		"layout": {
			"allowSizingOnChildren": true,
			"allowSwitching": true,
			"allowInheriting": true,
			"default": {
				"type": "flex",
				"orientation": "horizontal",
				"verticalAlignment": "top",
				"flexWrap": "nowrap"
			}
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"color": {
			"gradients": false,
			"background": false
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		}
	},
	"textdomain": "surecart",
	"render": "file:./view.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
