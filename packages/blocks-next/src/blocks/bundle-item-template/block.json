{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "surecart/bundle-item-template",
	"title": "Bundle Item",
	"description": "Template for a single bundle item.",
	"version": "1.0.0",
	"category": "surecart-product-page",
	"ancestor": ["surecart/product-bundle-items"],
	"usesContext": ["surecart/bundleItem"],
	"supports": {
		"interactivity": true,
		"inserter": false,
		"color": {
			"gradients": true,
			"text": true,
			"background": true,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"spacing": {
			"padding": true,
			"margin": ["top", "bottom"]
		},
		"__experimentalLayout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"default": {
				"type": "flex",
				"justifyContent": "left",
				"flexWrap": "nowrap"
			}
		},
		"layout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"allowSizingOnChildren": true,
			"default": {
				"type": "flex",
				"justifyContent": "left",
				"flexWrap": "nowrap"
			}
		}
	},
	"textdomain": "surecart",
	"render": "file:./view.php",
	"editorScript": "file:./index.js",
	"style": ["file:./style-index.css"]
}
