{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "surecart/product-review-average-rating-stars",
	"title": "Product Average Rating Stars",
	"description": "Display the product average rating stars.",
	"version": "1.0.0",
	"category": "surecart-product-page",
	"example": {},
	"ancestor": [
		"surecart/product-page",
		"surecart/product-quick-view",
		"surecart/product-review-list",
		"surecart/product-review-template",
		"surecart/sticky-purchase",
		"surecart/product-review-summary",
		"surecart/product-template"
	],
	"keywords": ["review", "average", "rating", "stars"],
	"attributes": {
		"fill_color": {
			"type": "string",
			"default": ""
		},
		"size": {
			"type": "number",
			"default": 20
		},
		"link_to_reviews": {
			"type": "boolean",
			"default": false
		},
		"show_for_zero_reviews": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"interactivity": true,
		"color": {
			"text": false,
			"link": false,
			"background": false,
			"__experimentalDefaultControls": {
				"background": false,
				"text": false
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": {
				"__experimentalDefault": "2px"
			},
			"__experimentalDefaultControls": {
				"padding": true,
				"margin": true,
				"blockGap": true
			}
		}
	},
	"textdomain": "surecart",
	"render": "file:./view.php",
	"style": "file:./style-index.css",
	"editorScript": "file:./index.js"
}
