{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "surecart/product-total-rating-value",
	"title": "Product Total Rating Value",
	"description": "Displays the total product rating value.",
	"version": "1.0.0",
	"category": "surecart-product-page",
	"parent": ["surecart/product-total-rating"],
	"usesContext": ["show_value"],
	"attributes": {
		"show_plus_sign": {
			"type": "boolean",
			"default": true
		}
	},
	"example": {},
	"supports": {
		"interactivity": true,
		"anchor": true,
		"color": {
			"gradients": true,
			"text": true,
			"background": true,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true,
				"fontAppearance": true,
				"textTransform": true
			}
		}
	},
	"textdomain": "surecart",
	"render": "file:./view.php",
	"editorScript": "file:./index.js"
}
